<Page x:Class="Rent_a_Car.MVVM.View.CarInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:local="clr-namespace:Rent_a_Car" xmlns:viewModel="clr-namespace:Rent_a_Car.MVVM.ViewModel"
      Title="Car Details"
      Background="Transparent"
      Opacity="0.95">
    
    <Page.DataContext>
        <viewModel:CarInfoViewModel/>
    </Page.DataContext>

    <Page.Triggers>
        <!-- Fade-in effect on page load -->
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.0" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
   

    <Border Background="{DynamicResource BackgroundGradient}" CornerRadius="10" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ScrollViewer.Template>
            <ControlTemplate TargetType="ScrollViewer">
                <Grid>
                    <ScrollContentPresenter />
                    <!-- Nevidljiv skrolbar -->
                    <ScrollBar x:Name="PART_VerticalScrollBar" Visibility="Collapsed" />
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Visibility="Collapsed" />
                </Grid>
            </ControlTemplate>
        </ScrollViewer.Template>
            <Grid>
                <!-- Definicija redova -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Navigacioni bar -->
                    <RowDefinition Height="*" />
                    <!-- Dinamički sadržaj -->
                </Grid.RowDefinitions>

                <!-- Navigation Bar -->
                <Border Grid.Row="0" Background="{DynamicResource CarInfoNavBackgroundSolid}" CornerRadius="10" Padding="10" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton Style="{DynamicResource NavButtonStyle}" Command="{Binding CarsDetailsViewCommand}" Content="Details" />
                        <ToggleButton Style="{DynamicResource NavButtonStyle}" Command="{Binding CarsSpecificationViewCommand}" Content="Specifications" />
                        <ToggleButton Style="{DynamicResource NavButtonStyle}" Command="{Binding CarsEquipmentViewCommand}" Content="Equipment" />
                        <ToggleButton Style="{DynamicResource NavButtonStyle}" Command="{Binding CarsExperienceViewCommand}" Content="Experience" />
                        <ToggleButton Style="{DynamicResource NavButtonStyle}" Command="{Binding CarsReservationViewCommand}" Content="Make Reservation" />
                    </StackPanel>
                </Border>

                <!-- Dinamički sadržaj -->
                <Frame NavigationUIVisibility="Hidden" Grid.Row="1"
                 Grid.Column="1"
                 Margin="10" Content="{Binding CurrentInfoView}"/>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>