<Window x:Class="Rent_a_Car.attempt2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rent_a_Car" 
        xmlns:viewModel="clr-namespace:Rent_a_Car.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="attempt2" Height="600" Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>

    <Border Background="{DynamicResource BackgroundGradient}" CornerRadius="5">
        <Grid>
            <!-- Navbar (meni) -->
            <StackPanel x:Name="MenuPanel"
                        Background="{DynamicResource NavBackgroundSolid}"
                        Width="60"
                        Orientation="Vertical"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Left"
                        ZIndex="1"
                        >
                <!-- Dugme za otvaranje menija -->
                <RadioButton x:Name="MenuToggleButton" 
                              VerticalAlignment="Top" 
                              HorizontalAlignment="Left"
                              Margin="0,10,0,0" 
                              Width="200" 
                              Height="50" 
                              Content="Menu"
                              FontSize="18"
                              Foreground="White"
                              Background="Transparent"
                              BorderThickness="0"
                              Style="{DynamicResource MainMenuButtonTheme}"
                              Tag="C:\Users\User\source\repos\Rent a Car\Rent a Car\img\main_window_icons\menuWhite.png" 
                              Click="menu_button_click"/>

                <!-- Stavke menija -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Cars" 
                          x:Name="a"
                          GroupName="MenuOptions"
                          Height="50"
                          Width="203"
                          FontSize="14"
                          Margin="-3,15,0,2"
                          Foreground="White"
                          IsChecked="True"
                          Command="{Binding CarsViewCommand}"
                          Style="{DynamicResource MenuButtonTheme}"
                          Tag="C:\Users\User\source\repos\Rent a Car\Rent a Car\img\main_window_icons\carsWhite.png"
                          Click="radio_button_click"/>
                          
                </StackPanel>


                <StackPanel Orientation="Horizontal" Height="50"  Cursor="Hand">
                    <RadioButton Content="Settings" 
                          Height="50"
                          Width="203"
                          Name="b"
                          GroupName="MenuOptions"
                          FontSize="14"
                          Foreground="White"
                          Margin="-3,0,0,2"
                          Command="{Binding SettingsViewCommand}"
                          Style="{DynamicResource MenuButtonTheme}"
                          Tag="C:\Users\User\source\repos\Rent a Car\Rent a Car\img\main_window_icons\settingsWhite.png"
                          Click="radio_button_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="50"  Cursor="Hand" >
                    <RadioButton Content="Activity Feed" 
                          Height="50"
                          Width="203"
                          Margin="-3,0,0,0"
                          GroupName="MenuOptions"
                          Name="c"
                          FontSize="14"
                          Foreground="White"
                          Command="{Binding ActivityFeedViewCommand}"
                          Style="{DynamicResource MenuButtonTheme}"
                          Tag="C:\Users\User\OneDrive\Radna površina\Projekat A\img\activity.png"
                          Click="radio_button_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="50" Margin="-3,5,0,0"  Cursor="Hand">
                    <RadioButton Content="Profile" 
                          Height="50"
                          Width="203"
                          GroupName="MenuOptions"
                          Name="e"
                          FontSize="14"
                          Foreground="White"
                          Command="{Binding ProfileViewCommand}"
                          Style="{DynamicResource MenuButtonTheme}"
                          Tag="C:\Users\User\source\repos\Rent a Car\Rent a Car\img\main_window_icons\personBlack.png"
                          Click="radio_button_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"  Margin="-3,268,0,0"  Cursor="Hand">
                    <RadioButton Content="Log Out" 
                          Height="50"
                          Width="203"
                          FontSize="14"
                          GroupName="MenuOptions"
                          Name="d"
                          Foreground="White"
                          Command="{Binding LogOutViewCommand}"
                          Style="{DynamicResource MenuButtonTheme}"
                          Click="logout_click"
                          Tag="C:\Users\User\source\repos\Rent a Car\Rent a Car\img\main_window_icons\signOut.png"/>
                </StackPanel>
            </StackPanel>

            <!-- Glavni sadržaj -->
            <Grid Margin="0,0,0,0" ZIndex="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" x:Name="MenuColumn" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75" />
                    <RowDefinition />
                </Grid.RowDefinitions>
              
                <!-- Header ili pretraga -->
                <StackPanel Grid.Column="1"  Orientation="Horizontal" Background="{DynamicResource BackgroundGradientR}">
                    <TextBlock Text="CAR RENTAL" 
                               Margin="280 15 0 0" 
                               Foreground="White" 
                               FontSize="40" 
                               FontFamily="Impact" 
                               Height="75">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" 
                                              ShadowDepth="0" 
                                              BlurRadius="0" 
                                              Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Glavni sadržaj stranice -->
                <Frame Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" 
                        Margin="60,0,0,0" 
                        Content="{Binding CurrentView}" />

                <!-- Overlay prikaz -->
                <Grid x:Name="OverlayContainer"
                      Background="Transparent"
                      Visibility="{Binding IsOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Grid.Column="1" Grid.Row="1">
                    <!-- Grid structure -->

                    <ContentControl Content="{Binding OverlayView}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Grid.Column="1" 
                                    Grid.Row="1"/>
                </Grid>
            </Grid>
            
        </Grid>
    </Border>
</Window>
