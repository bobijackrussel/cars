<UserControl x:Class="CarRentalManagment.Views.VehicleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CarRentalManagment.Utilities.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Vehicle Card Style -->
        <Style x:Key="VehicleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Card_MouseLeave" />
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Button Style -->
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource CardAltBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MutedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40,30,40,30">
            <StackPanel>
                <!-- Header Section -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="{DynamicResource Vehicles_Title}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Vehicles_Subtitle}"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Search and Filter Bar -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Height="50"
                            Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="20,0,12,0" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="{DynamicResource Vehicles_SearchPlaceholder}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                                           FontSize="15" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="2"
                                    Content="&#xE894;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Command="{Binding ClearSearchCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                    FontSize="14"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNullToVisibilityConverter}}"
                                    Margin="0,0,12,0"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Filters Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource FilterButton}"
                            Click="FiltersButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Vehicles_Filters}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Vehicle Cards Grid -->
                <Grid>
                    <ItemsControl ItemsSource="{Binding VehiclesView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource VehicleCard}"
                                        Width="280">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Vehicle Image -->
                                        <Border Grid.Row="0"
                                                CornerRadius="16,16,0,0"
                                                ClipToBounds="True"
                                                Background="{DynamicResource CardAltBackgroundBrush}">
                                            <Grid>
                                                <Image Source="{Binding PrimaryPhotoUrl}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasPrimaryPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- No Photo Placeholder -->
                                                <StackPanel VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding HasPrimaryPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xEB9F;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="32"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock Text="{DynamicResource Vehicles_NoPhoto}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Vehicle Info -->
                                        <StackPanel Grid.Row="1"
                                                    Margin="20"
                                                    Orientation="Vertical"
                                                    Spacing="8">
                                            <!-- Title and Subtitle -->
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Icons Row -->
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Seats -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7C4;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Seats}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{DynamicResource Vehicles_SeatsLabel}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Transmission -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE7C8;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding TransmissionDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Fuel -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="&#xE7C7;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding FuelDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Price and Button -->
                                            <Grid Margin="0,20,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Price -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding DailyRateDisplay}"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{DynamicResource Vehicles_PerDay}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Bottom"
                                                               Margin="6,0,0,4" />
                                                </StackPanel>

                                                <!-- View Details Button -->
                                                <Button Grid.Row="1"
                                                        Content="{DynamicResource Vehicles_ViewDetails}"
                                                        Style="{StaticResource ModernButton}"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectVehicleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading Indicator -->
                    <Border Background="{DynamicResource OverlayBrush}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="16">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="16"
                                Padding="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Vehicles_Loading}"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding Vehicles.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="&#xE7C5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="48"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="{DynamicResource Vehicles_Empty_Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Vehicles_Empty_Description}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Filter Sidebar (Initially Hidden) -->
        <Border x:Name="FilterSidebar"
                Grid.Column="1"
                Background="{DynamicResource CardAltBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Width="340"
                Visibility="Collapsed">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{DynamicResource Vehicles_Filter_Header}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedForegroundBrush}"
                            FontSize="16"
                            Cursor="Hand"
                            Click="CloseFilters_Click" />
                </Grid>

                <!-- Filter Options -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Vehicle Type -->
                        <TextBlock Text="{DynamicResource Vehicles_Filter_VehicleType}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding VehicleTypes}"
                                  SelectedItem="{Binding SelectedVehicleType, Mode=TwoWay}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="16,12"
                                  FontSize="14"
                                  Margin="0,0,0,24" />

                        <!-- Transmission -->
                        <TextBlock Text="{DynamicResource Vehicles_Filter_Transmission}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding TransmissionOptions}"
                                  SelectedItem="{Binding SelectedTransmission, Mode=TwoWay}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="16,12"
                                  FontSize="14"
                                  Margin="0,0,0,24" />

                        <!-- Price Range -->
                        <TextBlock Text="{DynamicResource Vehicles_Filter_PriceRange}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding PriceRanges}"
                                  SelectedItem="{Binding SelectedPriceRange, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="16,12"
                                  FontSize="14"
                                  Margin="0,0,0,24" />

                        <!-- Sort By -->
                        <TextBlock Text="{DynamicResource Vehicles_Filter_SortBy}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="16,12"
                                  FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
